network 0: top (instance top1)
  channel   fifo_0 SY int : src.oport1 -> inner1.port_0
  channel   fifo_1 SY int : inner1.port_1 -> snk.iport1
  leaf      src : SY::sconstant
    arg  init_val = 3
    arg  take = 4
    port oport1 out SY int
  composite inner1 : inner -> network 1
    port port_0 in  SY int
    port port_1 out SY int
  leaf      snk : SY::ssink
    arg  _func = snk_func
    port iport1 in  SY int
network 1: inner (instance inner1)
  port      port_0 in  SY int -> scale.iport1
  port      port_1 out SY int -> offset.oport1
  channel   fifo_0 SY int : scale.oport1 -> offset.iport1
  leaf      scale : SY::scomb
    arg  _func = scale_func
    port iport1 in  SY int
    port oport1 out SY int
  leaf      offset : SY::scomb
    arg  _func = offset_func
    port iport1 in  SY int
    port oport1 out SY int
--
ok   model has at least one network
ok   network 0 (top): order covers every node, port and channel exactly once
ok   network 0 (top): every channel endpoint names a node in this network
ok   network 0 (top): every boundary port names a node in this network
ok   network 0 (top): composite nodes resolve to distinct networks, leaves to none
ok   network 1 (inner): order covers every node, port and channel exactly once
ok   network 1 (inner): every channel endpoint names a node in this network
ok   network 1 (inner): every boundary port names a node in this network
ok   network 1 (inner): composite nodes resolve to distinct networks, leaves to none
ok   every network except the top is claimed by exactly one composite node
out 7
out 7
out 7
out 7
ok   a plain SC_MODULE yields one network
ok   the walk fallback finds every process in a non-composite container
ok   the walk fallback finds every signal in a non-composite container
all invariants hold