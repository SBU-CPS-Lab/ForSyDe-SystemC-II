#!/usr/bin/env python3
"""tools/legacy-kinds -- rewrite introspection XML back to pre-Phase-2 kind names.

ForSyDe::XMLExport (src/forsyde/xml.hpp) writes each process's
forsyde_kind() into a <process_constructor name="..." moc="..."/>
element (the "<MoC>::" prefix is split off into moc= by
get_moc_and_pc; only the part after it lands in name=). Phase 2 is
free to change what forsyde_kind() returns -- names now follow the
code rather than staying frozen for compatibility -- but existing
SDF3 and DeSyDe pipelines built against the pre-Phase-2 names should
not have to change to keep reading a model's exported XML. This script
is the seam: it rewrites a freshly emitted file's process_constructor
names back to what they were at the v1.0 tag, and nothing else.

LEGACY_KINDS is deliberately short. It was built by diffing every
forsyde_kind() string in the tree between the v1.0 tag and the current
HEAD (`git diff v1.0 HEAD` over every forsyde_kind() return in
src/forsyde/*.hpp) rather than guessed, and it is exactly the set of
names that actually changed:

  * MI's SY2SDF and SDF2SY were hand-written classes at v1.0; 2e folded
    them into the generic MI::strip<From,To> / MI::insert<From,To>
    templates (see mis.hpp), so their forsyde_kind() is now computed
    from the two MoC names rather than returning a fixed string. Every
    other MI class kept its own dedicated forsyde_kind() unchanged.
  * Two genuinely new interfaces appeared in 2e (SY2DT, DT2SY -- DT had
    no MoC interface at all before) and two genuinely new SDF classes
    in 2d (DDE::zipN, DDE::unzipN). None of the four has a legacy name
    to translate to, so none of them belongs in this map: a name with
    no pre-Phase-2 counterpart should pass through as itself, not be
    invented an entry.

Add to this map only when a forsyde_kind() is observed to actually
change -- re-run the same diff (git diff <old-tag> HEAD, grepping for
`return "..."` and any computed forsyde_kind() bodies in
src/forsyde/*.hpp) rather than adding an identity entry for every
class "just in case". A table that only records real changes is one
that cannot rot silently; a table pre-populated with identity entries
for everything else is just the class list with extra steps, and it
would need updating -- and could silently drift -- every time a class
is added, renamed, or removed regardless of whether its kind changed.

Usage:
    tools/legacy-kinds < new.xml > old.xml
    tools/legacy-kinds new.xml old.xml
    tools/legacy-kinds --list
    tools/legacy-kinds --selftest
"""
import re
import sys

# new process_constructor name -> the v1.0 name it replaces.
LEGACY_KINDS = {
    "strip<SY,SDF>":  "SY2SDF",
    "insert<SDF,SY>": "SDF2SY",
}


def _xml_escape(s: str) -> str:
    # Attribute values rapidxml_print emits are escaped the same way
    # (copy_and_expand_chars in rapidxml_print.hpp); a legacy-kinds
    # entry with none of these characters round-trips as itself.
    return (s.replace("&", "&amp;")
             .replace("<", "&lt;")
             .replace(">", "&gt;")
             .replace('"', "&quot;"))


# Matches only the name= attribute of a <process_constructor ...> tag,
# not any other element's name= (leaf_process, port, argument, ...),
# so nothing outside the process-constructor kind is ever touched.
_PC_NAME_RE = re.compile(
    r'(<process_constructor\b[^>]*\bname=")([^"]*)(")'
)

_ESCAPED_LEGACY_KINDS = {_xml_escape(new): old for new, old in LEGACY_KINDS.items()}


def translate(xml_text: str) -> str:
    def sub(m):
        escaped_name = m.group(2)
        return m.group(1) + _ESCAPED_LEGACY_KINDS.get(escaped_name, escaped_name) + m.group(3)
    return _PC_NAME_RE.sub(sub, xml_text)


_SELFTEST_INPUT = (
    '<?xml version="1.0" ?>\n'
    '<!-- Automatically generated by ForSyDe -->\n'
    '<!DOCTYPE process_network SYSTEM "forsyde.dtd" >\n'
    '<process_network>\n'
    '  <leaf_process name="conv1">\n'
    '    <process_constructor name="strip&lt;SY,SDF&gt;" moc="mi"/>\n'
    '  </leaf_process>\n'
    '  <leaf_process name="conv2">\n'
    '    <process_constructor name="insert&lt;SDF,SY&gt;" moc="mi"/>\n'
    '  </leaf_process>\n'
    '  <leaf_process name="conv3">\n'
    '    <process_constructor name="group&lt;DT,SY&gt;" moc="mi"/>\n'
    '  </leaf_process>\n'
    '  <leaf_process name="c1">\n'
    '    <process_constructor name="comb2" moc="sy"/>\n'
    '  </leaf_process>\n'
    '  <leaf_process name="odd_name_with_lt_in_it">\n'
    '    <argument name="strip&lt;SY,SDF&gt;" value="not a kind, must not change"/>\n'
    '  </leaf_process>\n'
    '</process_network>\n'
)


def _selftest():
    out = translate(_SELFTEST_INPUT)
    checks = [
        ('<process_constructor name="SY2SDF" moc="mi"/>' in out,
         "strip<SY,SDF> -> SY2SDF"),
        ('<process_constructor name="SDF2SY" moc="mi"/>' in out,
         "insert<SDF,SY> -> SDF2SY"),
        ('<process_constructor name="group&lt;DT,SY&gt;" moc="mi"/>' in out,
         "group<DT,SY> has no legacy name and must pass through unchanged"),
        ('<process_constructor name="comb2" moc="sy"/>' in out,
         "a kind that never changed must pass through unchanged"),
        ('<argument name="strip&lt;SY,SDF&gt;" value="not a kind, must not change"/>' in out,
         "an argument's own name= must never be touched, only "
         "process_constructor's"),
    ]
    failed = [msg for ok, msg in checks if not ok]
    if failed:
        print("FAIL", file=sys.stderr)
        for msg in failed:
            print(f"  - {msg}", file=sys.stderr)
        print("--- translated output ---", file=sys.stderr)
        print(out, file=sys.stderr)
        return 1
    print(f"PASS ({len(checks)} checks)")
    return 0


def main(argv):
    if len(argv) > 1 and argv[1] == "--list":
        for new, old in LEGACY_KINDS.items():
            print(f"{new} -> {old}")
        return 0

    if len(argv) > 1 and argv[1] == "--selftest":
        return _selftest()

    if len(argv) >= 3:
        with open(argv[1], "r", encoding="utf-8") as f:
            text = f.read()
        out = translate(text)
        with open(argv[2], "w", encoding="utf-8") as f:
            f.write(out)
    elif len(argv) == 2:
        with open(argv[1], "r", encoding="utf-8") as f:
            text = f.read()
        sys.stdout.write(translate(text))
    else:
        text = sys.stdin.read()
        sys.stdout.write(translate(text))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
